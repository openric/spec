#
# OpenRiC SHACL shapes — full-graph checks
# ========================================
# These shapes assume the entire RiC-O graph is loaded into the data graph
# before validation. They do cross-entity queries (e.g. "is this instantiation
# linked from any record?", "is this agent orphaned?") that produce false
# positives on single-document API responses.
#
# Run these only against a full triple store dump, not against `/records/{id}`,
# `/agents/{id}`, etc. responses.
#
# Usage (example):
#   pyshacl -s full-graph.shacl.ttl -d full-store.nt -f human

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix : <https://openric.org/shapes/full-graph#> .


:InstantiationLinkedFromRecordShape a sh:NodeShape ;
    sh:targetClass rico:Instantiation ;
    sh:name "Instantiation-Record Link Check" ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Instantiation should be linked from a Record via rico:hasOrHadInstantiation" ;
        sh:select """
            SELECT $this WHERE {
                $this a rico:Instantiation .
                FILTER NOT EXISTS {
                    ?record rico:hasOrHadInstantiation $this .
                }
            }
        """
    ] .


:OrphanedRecordShape a sh:NodeShape ;
    sh:targetClass rico:Record ;
    sh:name "Orphaned Record Detection" ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Record has no parent and is not a top-level fonds" ;
        sh:select """
            SELECT $this WHERE {
                $this a rico:Record .
                FILTER NOT EXISTS {
                    { $this rico:isOrWasIncludedIn ?parent } UNION
                    { ?parent rico:includesOrIncluded $this } UNION
                    { $this rico:isOrWasPartOf ?parent }
                }
            }
        """
    ] .


:UnlinkedAgentShape a sh:NodeShape ;
    sh:targetClass rico:Person, rico:CorporateBody, rico:Family ;
    sh:name "Unlinked Agent Detection" ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "Agent is not linked to any records or activities" ;
        sh:select """
            SELECT $this WHERE {
                { $this a rico:Person } UNION
                { $this a rico:CorporateBody } UNION
                { $this a rico:Family }
                # Linked by any RiC-O property, either way, to a record resource, an instantiation or an
                # activity: as holder, performer or subject too (openric/spec#76).
                FILTER NOT EXISTS {
                    { ?x ?p $this } UNION { $this ?p ?x }
                    FILTER (STRSTARTS(STR(?p), "https://www.ica.org/standards/RiC/ontology#"))
                    { ?x a rico:RecordSet } UNION { ?x a rico:Record } UNION { ?x a rico:RecordPart }
                    UNION { ?x a rico:Instantiation } UNION { ?x a rico:Activity }
                }
            }
        """
    ] .


:DuplicateIdentifierShape a sh:NodeShape ;
    sh:targetClass rico:RecordSet, rico:Record ;
    sh:name "Duplicate Identifier Detection" ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Multiple records share the same identifier" ;
        sh:select """
            SELECT $this WHERE {
                $this rico:identifier ?id .
                ?other rico:identifier ?id .
                FILTER($this != ?other)
            }
        """
    ] .
