{
    "name": "RIC-O Linked Data API",
    "version": "0.17.15",
    "description": "Linked Data publication endpoints for RIC-O compliant serialization",
    "docs": "https://ric.theahg.co.za/api/ric/v1/docs",
    "openapi": "https://ric.theahg.co.za/api/ric/v1/openapi.json",
    "openric_conformance": {
        "spec_version": "0.46.0",
        "latest_spec_version": "0.46.0",
        "spec_delta": "https://openric.org/drift-log.html",
        "profiles": [
            {
                "id": "core-discovery",
                "version": "0.4.0",
                "conformance": "full"
            },
            {
                "id": "authority-context",
                "version": "0.4.0",
                "conformance": "full"
            },
            {
                "id": "graph-traversal",
                "version": "0.5.0",
                "conformance": "full"
            },
            {
                "id": "digital-object-linkage",
                "version": "0.6.0",
                "conformance": "full"
            },
            {
                "id": "round-trip-editing",
                "version": "0.7.0",
                "conformance": "full"
            },
            {
                "id": "export-only",
                "version": "0.9.0",
                "conformance": "full"
            },
            {
                "id": "sparql-access",
                "version": "0.1.0",
                "conformance": "full",
                "status": "draft",
                "access": "public-read",
                "rate_limit": "60/minute/IP",
                "max_query_time_seconds": 30,
                "endpoint": "/api/ric/v1/sparql"
            }
        ]
    }
}
