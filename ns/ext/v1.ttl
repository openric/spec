# OpenRiC Extension Ontology v1
# =============================
# Versioned extension namespace for terms used by OpenRiC implementations
# but NOT defined in canonical RiC-O 1.1.
#
# Namespace IRI: https://openric.org/ns/ext/v1#
# Status:        Active; ontology version 1.3.1 (spec v0.52.1). Term IRIs stay
#                under /v1#; each release has its own owl:versionIRI.
# Catalyst:      ICA-EGAD reviewer feedback, April 2026 (audit/ric-o-1.1-audit.html)
# Licence:       CC-BY 4.0
#
# OpenRiC commits never to mint new terms in the ICA RiC-O namespace.
# Terms not defined by RiC-O 1.1 are placed here, and their canonical
# semantics are documented in the OpenRiC mapping spec
# (https://openric.org/spec/mapping.html).
#
# Some terms in this file are pragmatic extensions (e.g. response-envelope
# classes for paginated lists). Others are open candidates for upstream
# proposal to ICA-EGAD (e.g. ContactPoint, hasAppraisalInformation,
# containsPersonalData). See https://openric.org/audit/ric-o-1.1-audit.html
# §F (upstream proposals).

@prefix openricx: <https://openric.org/ns/ext/v1#> .
@prefix rico:     <https://www.ica.org/standards/RiC/ontology#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix vann:     <http://purl.org/vocab/vann/> .
@prefix openric:  <https://openric.org/ns/v1#> .

<https://openric.org/ns/ext/v1>
    a owl:Ontology ;
    dcterms:title "OpenRiC Extension Ontology v1"@en ;
    dcterms:description "Versioned extension namespace for archival terms used by OpenRiC implementations but not defined in canonical RiC-O 1.1. Pragmatic API/response-envelope classes plus candidate-upstream archival semantic terms."@en ;
    dcterms:creator "The Archive and Heritage Digital Commons Group (Pty) Ltd / OpenRiC project" ;
    dcterms:issued "2026-04-25"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "openricx" ;
    vann:preferredNamespaceUri "https://openric.org/ns/ext/v1#" ;
    rdfs:seeAlso <https://openric.org/spec/mapping.html> ,
                 <https://openric.org/audit/ric-o-1.1-audit.html> ;
    rdfs:seeAlso <https://www.ica.org/standards/RiC/ontology/1.1> ;
    dcterms:requires <https://www.ica.org/standards/RiC/ontology/1.1> ;
    dcterms:modified "2026-10-19"^^xsd:date ;
    owl:versionIRI <https://openric.org/ns/ext/v1.3.1> ;
    owl:priorVersion <https://openric.org/ns/ext/v1.3.0> ;
    owl:versionInfo "1.3.1" .

# =====================================================================
# 1. Classes
# =====================================================================

# 1.1 List envelope classes (response-shape extensions)
# These types appear as @type values on JSON-LD list responses
# (e.g. /api/ric/v1/records returns @type: openricx:RecordList).

openricx:RecordList         a owl:Class ; rdfs:label "Record List"@en ;
    rdfs:comment "Response envelope wrapping a paginated list of rico:Record entities."@en .
openricx:RecordSetList      a owl:Class ; rdfs:label "Record-Set List"@en ;
    rdfs:comment "Response envelope wrapping a paginated list of rico:RecordSet entities."@en .
openricx:AgentList          a owl:Class ; rdfs:label "Agent List"@en ;
    rdfs:comment "Response envelope wrapping a paginated list of rico:Agent entities (any subtype)."@en .
openricx:PlaceList          a owl:Class ; rdfs:label "Place List"@en ;
    rdfs:comment "Response envelope wrapping a paginated list of rico:Place entities."@en .
openricx:RuleList           a owl:Class ; rdfs:label "Rule List"@en ;
    rdfs:comment "Response envelope wrapping a paginated list of rico:Rule entities."@en .
openricx:ActivityList       a owl:Class ; rdfs:label "Activity List"@en ;
    rdfs:comment "Response envelope wrapping a paginated list of rico:Activity entities."@en .
openricx:InstantiationList  a owl:Class ; rdfs:label "Instantiation List"@en ;
    rdfs:comment "Response envelope wrapping a paginated list of rico:Instantiation entities."@en .
openricx:FunctionList       a owl:Class ; rdfs:label "Function List"@en ;
    rdfs:comment "Response envelope wrapping a paginated list of openricx:Function entities."@en .
openricx:RepositoryList     a owl:Class ; rdfs:label "Repository List"@en ;
    rdfs:comment "Response envelope wrapping a list of repositories (rico:CorporateBody, ISDIAH). Added 2026-10-15; GET /repositories already returned it."@en .

# 1.2 Semantic extension classes (candidate-upstream)

openricx:Function a owl:Class ; rdfs:label "Function"@en ;
    rdfs:comment "ISDF business / archival function. Used as the canonical class for OpenRiC's /functions API surface, pending ICA-EGAD guidance on whether RiC-O should define such a class or model functions as SKOS Concepts of rico:OccupationType / rico:ActivityType. Implementations MAY canonically expand an openricx:Function to a rico:Activity classified by an OccupationType IRI."@en .

openricx:ContactPoint a owl:Class ; rdfs:label "Contact Point"@en ;
    rdfs:comment "A repository or organisation contact point - physical address, telephone, email, opening hours. Modelled as an OpenRiC extension because RiC-O 1.1 does not define rico:ContactPoint. Open candidate for upstream proposal; alternatives include schema.org/ContactPoint and vCard."@en .

openricx:DateRange a owl:Class ; rdfs:label "Date Range"@en ;
    rdfs:subClassOf rico:Date ;
    rdfs:comment "A structured date range with beginning, end, and an optional human-readable expressedDate qualifier (e.g. 'circa 1961', 'late 19th century'). Retained as an extension because RiC-O 1.1 dropped its own DateRange class. Its literal endpoints go on the datatype properties rico:beginningDate and rico:endDate, and its type on rico:hasDateType pointing at a concept in https://openric.org/vocab/date-type/. Canonical RDF MAY instead link the entity to a rico:Date node with the object properties rico:hasBeginningDate / rico:hasEndDate, which never carry a literal. Revised in v0.50.0: declared a subclass of rico:Date, so that rico:hasDateType applies to it."@en .

openricx:DateRangeSet a owl:Class ; rdfs:label "Date Range Set"@en ;
    rdfs:comment "A collection of openricx:DateRange instances when an entity has multiple, scoped date ranges (e.g. dates of existence, dates of activity, dates of publication)."@en .

openricx:Checksum a owl:Class ; rdfs:label "Checksum"@en ;
    rdfs:comment "Structured checksum carrying an algorithm and a hex-encoded value. Optional alternative to a free-text 'Checksum (sha256): <hex>' string inside openricx:technicalCharacteristics. Aligns with PREMIS checksum modelling."@en .

openricx:Carrier a owl:Class ; rdfs:label "Carrier"@en ;
    rdfs:subClassOf rico:Thing ;
    rdfs:comment "An individual physical medium that bears one or more instantiations, such as a specific magnetic tape, disc or volume, with its own identifier, condition and custody history. Distinct from rico:CarrierType, which is the kind of medium. RiC-O 1.1 has no carrier entity; ICA-EGAD (Records_in_Contexts_users list, July 2026) plans a Carrier class for RiC-O 2.0 and advised a subclass of rico:Thing meanwhile. Added in 1.3.0; defined in the reference service since its v0.17.0."@en .

openricx:Occupation a owl:Class ; rdfs:label "Occupation"@en ;
    rdfs:subClassOf rico:Thing ;
    rdfs:comment "An occupation an agent held, with its own dates and whether it is current. RiC-O 1.1 has rico:OccupationType, the kind of occupation, and rico:hasOrHadOccupationOfType from a person to that kind, but no class for an occupation actually held over a period. The reference service sent these nodes as rico:Occupation, which RiC-O 1.1 does not define, until its v0.17.25. Added in 1.3.0."@en .

# =====================================================================
# 2. Properties
# =====================================================================

# 2.1 Address & contact (candidate-upstream)

openricx:contact a owl:ObjectProperty ; rdfs:label "contact"@en ;
    rdfs:subPropertyOf rico:isRelatedTo ;
    rdfs:domain rico:Agent ; rdfs:range openricx:ContactPoint ;
    rdfs:comment "Links an Agent (typically a CorporateBody / repository) to a ContactPoint."@en .

openricx:streetAddress a owl:DatatypeProperty ; rdfs:label "street address"@en ;
    rdfs:domain openricx:ContactPoint ; rdfs:range xsd:string ;
    rdfs:comment "Street and number of a ContactPoint (ISDIAH 5.2.1 Location and address)."@en .
openricx:city a owl:DatatypeProperty ; rdfs:label "city"@en ;
    rdfs:domain openricx:ContactPoint ; rdfs:range xsd:string ;
    rdfs:comment "Town or city of a ContactPoint."@en .
openricx:postalCode a owl:DatatypeProperty ; rdfs:label "postal code"@en ;
    rdfs:domain openricx:ContactPoint ; rdfs:range xsd:string ;
    rdfs:comment "Postal code of a ContactPoint."@en .
openricx:country a owl:DatatypeProperty ; rdfs:label "country"@en ;
    rdfs:domain openricx:ContactPoint ; rdfs:range xsd:string ;
    rdfs:comment "Country of a ContactPoint, as a name or an ISO 3166 code."@en .
openricx:telephone a owl:DatatypeProperty ; rdfs:label "telephone"@en ;
    rdfs:domain openricx:ContactPoint ; rdfs:range xsd:string ;
    rdfs:comment "Telephone number of a ContactPoint (ISDIAH 5.2.2 Telephone, fax, email)."@en .
openricx:email a owl:DatatypeProperty ; rdfs:label "email"@en ;
    rdfs:domain openricx:ContactPoint ; rdfs:range xsd:string ;
    rdfs:comment "Email address of a ContactPoint (ISDIAH 5.2.2)."@en .

# 2.2 Date-range linking properties (parallel to RiC-O 1.1's date model;
# see openricx:DateRange / DateRangeSet rationale above)

openricx:hasDateRange    a owl:ObjectProperty ; rdfs:label "has date range"@en ;
    rdfs:subPropertyOf rico:isAssociatedWithDate ;
    rdfs:range openricx:DateRange ;
    rdfs:comment "Links an entity to one openricx:DateRange."@en .
openricx:hasDateRangeSet a owl:ObjectProperty ; rdfs:label "has date range set"@en ;
    rdfs:range openricx:DateRangeSet ;
    rdfs:comment "Links an entity to its dates, as one or more openricx:DateRange objects; the API shape for the dates of a record, an agent or a relation (mapping section 7.2)."@en .

# 2.3 Description / note properties (general prose)

openricx:description a owl:DatatypeProperty ; rdfs:label "description"@en ;
    rdfs:comment "General prose description. Equivalent to dcterms:description; OpenRiC uses openricx:description to keep the extension scope explicit on records that mix RiC-O properties and OpenRiC pragmatic fields. Implementations MAY substitute dcterms:description in canonical RDF."@en .

openricx:descriptiveNote a owl:DatatypeProperty ; rdfs:label "descriptive note"@en ;
    rdfs:subPropertyOf rico:note ;
    rdfs:comment "Archivist's note attached to a description - typically context, methodology, or qualification. Distinct from openricx:description (which describes the entity itself)."@en .

openricx:generalContext a owl:DatatypeProperty ; rdfs:label "general context"@en ;
    rdfs:subPropertyOf rico:note ;
    rdfs:comment "ISAAR(CPF) 5.2.8 general-context field - the broad social, political, or institutional context surrounding an Agent."@en .

openricx:arrangement a owl:DatatypeProperty ; rdfs:label "arrangement"@en ;
    rdfs:comment "ISAD(G) 3.3.4 system-of-arrangement field on a RecordSet. Deprecated 2026-10-15: RiC-O 1.1 defines rico:structure (RiC-AG comparison, mapping O-8)."@en ;
    owl:deprecated true ;
    dcterms:isReplacedBy <https://www.ica.org/standards/RiC/ontology#structure> .

openricx:publicationInformation a owl:DatatypeProperty ; rdfs:label "publication information"@en ;
    rdfs:subPropertyOf rico:note ;
    rdfs:comment "ISAD(G) 3.5.4 publication note."@en .

# 2.4 Internal-structure / hierarchy

openricx:hasInternalStructure a owl:DatatypeProperty ; rdfs:label "has internal structure"@en ;
    rdfs:comment "ISAAR(CPF) 5.2.7 internal-structures / genealogy field."@en .

openricx:hasOrHadPolicy a owl:ObjectProperty ; rdfs:label "has or had policy"@en ;
    rdfs:comment "Links an entity to a policy that has governed it (extension; RiC-O 1.1 has no direct equivalent)."@en .

# 2.5 Geographical context (candidate-upstream)

openricx:hasBroaderGeographicalContext a owl:ObjectProperty ;
    rdfs:label "has broader geographical context"@en ;
    rdfs:domain rico:Place ; rdfs:range rico:Place ;
    rdfs:comment "A place lies within a broader one. Deprecated 2026-10-19 (ontology 1.2.0): RiC-O 1.1 defines rico:isOrWasContainedBy between two places, for geographical or administrative regions."@en ;
    owl:deprecated true ;
    dcterms:isReplacedBy <https://www.ica.org/standards/RiC/ontology#isOrWasContainedBy> .
openricx:hasNarrowerGeographicalContext a owl:ObjectProperty ;
    rdfs:label "has narrower geographical context"@en ;
    rdfs:domain rico:Place ; rdfs:range rico:Place ;
    rdfs:comment "A place contains a narrower one. Deprecated 2026-10-19 (ontology 1.2.0): RiC-O 1.1 defines rico:containsOrContained between two places."@en ;
    owl:deprecated true ;
    dcterms:isReplacedBy <https://www.ica.org/standards/RiC/ontology#containsOrContained> .
openricx:jurisdiction a owl:DatatypeProperty ; rdfs:label "jurisdiction"@en ;
    rdfs:comment "Free-text jurisdiction marker on a rico:Rule (e.g. 'Egypt'). Canonical alternative: link to a rico:Place via rico:hasOrHadJurisdiction. Deprecated 2026-10-15 without ever being emitted: the Authority & Context profile and every implementation use openric:jurisdiction."@en ;
    owl:deprecated true ;
    dcterms:isReplacedBy openric:jurisdiction .

# 2.6 Names / labels (auxiliary forms)

openricx:alternativeForm a owl:DatatypeProperty ; rdfs:label "alternative form"@en ;
    rdfs:comment "Alternative form of a name - variants, transliterations, alias spellings. RiC-O 1.1's structured AgentName / PlaceName patterns are preferred for canonical RDF; openricx:alternativeForm is a pragmatic shortcut."@en .

openricx:normalizedForm a owl:DatatypeProperty ; rdfs:label "normalized form"@en ;
    rdfs:comment "Normalized form of a name (machine-comparable canonical form)."@en .

openricx:otherName a owl:DatatypeProperty ; rdfs:label "other name"@en ;
    rdfs:comment "Any other name by which an agent is or was known (ISAAR(CPF) 5.1.5). Canonical alternative: rico:hasOrHadAgentName with a rico:AgentName."@en .

openricx:languageCode a owl:DatatypeProperty ; rdfs:label "language code"@en ;
    rdfs:comment "Free-text language code (e.g. 'en', 'fra', 'zh-Hans'). Canonical alternative: rico:hasOrHadLanguage pointing at an ISO-639 IRI on a Record, RecordPart or Agent; on a RecordSet, rico:hasOrHadAllMembersWithLanguage or rico:hasOrHadSomeMembersWithLanguage."@en .

# 2.7 Privacy / access (candidate-upstream)

openricx:containsPersonalData a owl:DatatypeProperty ;
    rdfs:label "contains personal data"@en ;
    rdfs:domain rico:RecordResource ; rdfs:range xsd:boolean ;
    rdfs:comment "True if the resource is known to contain personally identifiable information. Open candidate for upstream proposal to ICA-EGAD; current placement here keeps the rico: namespace clean."@en .

# 2.8 Appraisal (candidate-upstream)

openricx:hasAppraisalInformation a owl:DatatypeProperty ;
    rdfs:label "has appraisal information"@en ;
    rdfs:subPropertyOf rico:note ;
    rdfs:comment "ISAD(G) 3.3.2 appraisal / destruction / scheduling. Open candidate for upstream proposal."@en .

# 2.9 Occupation (canonical-pattern shortcut)

openricx:hasOccupation a rdf:Property ; rdfs:label "has occupation"@en ;
    rdfs:domain rico:Agent ;
    rdfs:comment "An agent's occupation, as free text or as a SKOS Concept of rico:OccupationType. For a person whose occupation is a concept, use RiC-O 1.1's own property, rico:hasOrHadOccupationOfType (domain rico:Person, range rico:OccupationType), instead. This term covers what that property does not: occupations of other agents, and occupations recorded only as text, as the reference service sends them. Revised in v0.48.0: the earlier comment said RiC-O 1.1 had no direct link and did not mention the person property."@en .

# 2.10 Carrier / format (candidate-upstream)

openricx:hasMimeType a owl:DatatypeProperty ; rdfs:label "has MIME type"@en ;
    rdfs:domain rico:Instantiation ; rdfs:range xsd:string ;
    rdfs:comment "MIME / IMT type of an Instantiation (e.g. 'image/tiff'). Canonical alternative: dcterms:format pointing at a media-type IRI."@en .
openricx:mimeType a owl:DatatypeProperty ; rdfs:label "MIME type"@en ;
    rdfs:comment "Older spelling of openricx:hasMimeType, kept because existing data uses it."@en .
openricx:size a owl:DatatypeProperty ; rdfs:label "size"@en ;
    rdfs:comment "Size of an instantiation (free-form - bytes, pages, minutes). Use rico:hasExtent + rico:Extent for structured cases."@en .
openricx:hasPhysicalCharacteristics a owl:DatatypeProperty ;
    rdfs:label "has physical characteristics"@en ;
    rdfs:comment "Physical characteristics of an Instantiation. Deprecated 2026-10-19 (ontology 1.2.0): RiC-O 1.1 defines rico:physicalCharacteristicsNote on rico:Instantiation."@en ;
    owl:deprecated true ;
    dcterms:isReplacedBy <https://www.ica.org/standards/RiC/ontology#physicalCharacteristicsNote> .
openricx:technicalCharacteristics a owl:DatatypeProperty ;
    rdfs:label "technical characteristics"@en ;
    rdfs:comment "Free-text technical characteristics of an Instantiation (codec, bit depth, format profile, etc.). Used by the reference implementation to also carry inline checksums in the conventional 'Checksum (sha256): <hex>' form. RiC-O 1.1 has a rico:technicalCharacteristics, but its domain is rico:Mechanism, so it does not cover an Instantiation."@en .
openricx:productionTechnicalCharacteristics a owl:DatatypeProperty ;
    rdfs:label "production technical characteristics"@en ;
    rdfs:comment "How an Instantiation was produced. Deprecated 2026-10-19 (ontology 1.2.0): RiC-O 1.1 defines rico:productionTechnique on rico:Instantiation."@en ;
    owl:deprecated true ;
    dcterms:isReplacedBy <https://www.ica.org/standards/RiC/ontology#productionTechnique> .

# 2.11 Checksum (candidate-upstream)

openricx:hasChecksum a owl:ObjectProperty ; rdfs:label "has checksum"@en ;
    rdfs:subPropertyOf rico:isRelatedTo ;
    rdfs:domain rico:Instantiation ; rdfs:range openricx:Checksum ;
    rdfs:comment "Links an Instantiation to a structured Checksum. RiC-O 1.1 has no checksum term."@en .
openricx:algorithm a owl:DatatypeProperty ; rdfs:label "algorithm"@en ;
    rdfs:domain openricx:Checksum ; rdfs:range xsd:string ;
    rdfs:comment "Checksum algorithm name (e.g. 'sha256', 'md5')."@en .
openricx:checksumValue a owl:DatatypeProperty ; rdfs:label "checksum value"@en ;
    rdfs:domain openricx:Checksum ; rdfs:range xsd:string ;
    rdfs:comment "Hex-encoded checksum value."@en .

# 2.12 Source-standard notes with no RiC-O 1.1 property (mapping §7.1, §7.4)
# Added 2026-10-15. The mapping named these openric:*, a namespace reserved for
# API and viewing terms; no implementation emitted them under that name.

openricx:accrualsNote a owl:DatatypeProperty ; rdfs:label "accruals note"@en ;
    rdfs:comment "ISAD(G) 3.3.3 Accruals. Added in error on 2026-10-15: RiC-O 1.1 defines rico:accruals. Deprecated the same day, never emitted."@en ;
    owl:deprecated true ;
    dcterms:isReplacedBy <https://www.ica.org/standards/RiC/ontology#accruals> .
openricx:institutionType a owl:DatatypeProperty ; rdfs:label "institution type"@en ;
    rdfs:comment "ISDIAH 5.1.5 Type of the institution holding archives, as free text or a local term."@en .
openricx:openingHours a owl:DatatypeProperty ; rdfs:label "opening hours"@en ;
    rdfs:subPropertyOf rico:note ;
    rdfs:comment "ISDIAH 5.4.1 Opening times of a repository."@en .
openricx:accessibility a owl:DatatypeProperty ; rdfs:label "accessibility"@en ;
    rdfs:subPropertyOf rico:note ;
    rdfs:comment "ISDIAH 5.4.3 Accessibility: how to reach the repository and the access it offers to people with disabilities."@en .

# 2.13 SPARQL endpoint description (SPARQL Access draft profile, GET /sparql/info)
# Added 2026-10-15; already emitted by the reference service and the sparql-info fixture.

openricx:accessPolicy a owl:DatatypeProperty ; rdfs:label "access policy"@en ;
    rdfs:comment "Who may query the SPARQL endpoint, e.g. 'public-read'."@en .
openricx:rateLimit a owl:DatatypeProperty ; rdfs:label "rate limit"@en ;
    rdfs:comment "Request limit applied to the endpoint, e.g. '60/minute/IP'."@en .
openricx:maxQueryTimeSeconds a owl:DatatypeProperty ; rdfs:label "maximum query time in seconds"@en ;
    rdfs:range xsd:integer ;
    rdfs:comment "Longest a SPARQL query may run on the endpoint before it is stopped, in seconds."@en .
openricx:exampleQueriesUrl a owl:DatatypeProperty ; rdfs:label "example queries URL"@en ;
    rdfs:comment "Where the endpoint publishes example queries."@en .


# 2.14 Relation qualifiers (added in 1.3.0; relationHasLanguage in 1.3.1)
# RiC-O 1.1 qualifies a role only on rico:CreationRelation (rico:creationWithRole).
# ICA-EGAD (Records_in_Contexts_users list, June 2026) intends a generic property
# for RiC-O 1.2 and advised an extension meanwhile; when 1.2 ships it is bound
# here with owl:equivalentProperty.

openricx:relationHasAgentRole a owl:ObjectProperty ; rdfs:label "relation has agent role"@en ;
    rdfs:domain rico:Relation ; rdfs:range rico:RoleType ;
    rdfs:seeAlso rico:creationWithRole ;
    rdfs:comment "Relates a rico:Relation that involves one or more agents to the rico:RoleType in which the agents took part, such as bride, witness, donor or editor. Generalises rico:creationWithRole to any agent-involving relation. Emitted by the reference service on reified rico:EventRelation nodes."@en .

# An axiom about a RiC-O term, not a new term in the RiC-O namespace: existing
# creation-role data is reachable through the generic property without migration.
rico:creationWithRole rdfs:subPropertyOf openricx:relationHasAgentRole .

# The language sibling of relationHasAgentRole: the language of a performance
# belongs to the reified relation (this agent, performing this activity), not to
# the activity or the agent, so rico:hasOrHadLanguage is not widened to Activity.
# Raised on RiC-O issue #146 and the Records_in_Contexts_users list; RiC-O 1.2
# plans a PerformanceRelation-specific property, which this generic one subsumes.

openricx:relationHasLanguage a owl:ObjectProperty ; rdfs:label "relation has language"@en ;
    rdfs:domain rico:Relation ; rdfs:range rico:Language ;
    rdfs:seeAlso rico:hasOrHadLanguage , <https://github.com/ICA-EGAD/RiC-O/issues/146> ;
    rdfs:comment "Relates a rico:Relation, typically a rico:PerformanceRelation but also a creation or event relation, to a rico:Language used in the context of that relation, such as the language in which a performance was given. Keeps the language a qualifier of the relation rather than a property of the activity."@en .

# 2.15 Kinship of care (added in 1.3.0; defined in the reference service since v0.17.0)
# RiC-O 1.1 has rico:hasChild, rico:hasSibling and rico:hasOrHadSpouse under
# rico:hasFamilyAssociationWith, and nothing for adoption, fostering or guardianship.
# An adopted child is a legal child, so only hasAdoptedChild specialises rico:hasChild.

openricx:hasAdoptedChild a owl:ObjectProperty ; rdfs:label "has adopted child"@en ;
    rdfs:subPropertyOf rico:hasChild ;
    owl:inverseOf openricx:isOrWasAdoptedChildOf ;
    rdfs:comment "The subject agent adopted the object person as their child (legal adoption)."@en .
openricx:isOrWasAdoptedChildOf a owl:ObjectProperty ; rdfs:label "is or was adopted child of"@en ;
    rdfs:subPropertyOf rico:hasFamilyAssociationWith ;
    rdfs:comment "The subject person is or was the adopted child of the object agent."@en .
openricx:hasFosterChild a owl:ObjectProperty ; rdfs:label "has foster child"@en ;
    rdfs:subPropertyOf rico:hasFamilyAssociationWith ;
    owl:inverseOf openricx:isOrWasFosterChildOf ;
    rdfs:comment "The subject agent fostered the object person: care without legal adoption."@en .
openricx:isOrWasFosterChildOf a owl:ObjectProperty ; rdfs:label "is or was foster child of"@en ;
    rdfs:subPropertyOf rico:hasFamilyAssociationWith ;
    rdfs:comment "The subject person is or was fostered by the object agent."@en .
openricx:isOrWasGuardianOf a owl:ObjectProperty ; rdfs:label "is or was guardian of"@en ;
    rdfs:subPropertyOf rico:hasFamilyAssociationWith ;
    owl:inverseOf openricx:isOrWasUnderGuardianshipOf ;
    rdfs:seeAlso rico:Mandate ;
    rdfs:comment "The subject agent is or was the legal guardian of the object person. Directional, although its parent property is symmetric. Where the guardianship rests on a legal instrument, also relate the persons through a rico:Mandate."@en .
openricx:isOrWasUnderGuardianshipOf a owl:ObjectProperty ; rdfs:label "is or was under the guardianship of"@en ;
    rdfs:subPropertyOf rico:hasFamilyAssociationWith ;
    rdfs:comment "The subject person is or was under the legal guardianship of the object agent."@en .

# Care in an institution is not a kinship property: model the residency as a
# rico:Activity whose participants carry openricx:relationHasAgentRole
# (resident, carer), with the dates on the activity or the relation.

# 2.16 Carrier (added in 1.3.0; see openricx:Carrier)
# rico:hasCarrierType names the kind of medium; openricx:hasCarrier names the
# individual object. One tape may bear several instantiations (tracks), so
# hasCarrier is many-to-one.

openricx:hasCarrier a owl:ObjectProperty ; rdfs:label "has carrier"@en ;
    rdfs:domain rico:Instantiation ; rdfs:range openricx:Carrier ;
    owl:inverseOf openricx:isCarrierOf ;
    rdfs:comment "Relates a rico:Instantiation to the individual physical openricx:Carrier on which it is inscribed. Emitted by the reference service."@en .
openricx:isCarrierOf a owl:ObjectProperty ; rdfs:label "is carrier of"@en ;
    rdfs:domain openricx:Carrier ; rdfs:range rico:Instantiation ;
    rdfs:comment "The subject physical carrier bears the object rico:Instantiation."@en .

# 2.17 Rule details (added in 1.3.0; sent by the reference service on rico:Rule
# nodes typed by https://openric.org/vocab/rule-type/). A rule's period uses
# RiC-O 1.1's rico:beginningDate and rico:endDate.

openricx:restrictionType a owl:DatatypeProperty ; rdfs:label "restriction type"@en ;
    rdfs:domain rico:Rule ;
    rdfs:comment "The kind of access restriction a rule imposes, as a code or term from the holding system, for example a cultural-sensitivity or privacy restriction."@en .
openricx:customText a owl:DatatypeProperty ; rdfs:label "custom text"@en ;
    rdfs:subPropertyOf rico:note ; rdfs:domain rico:Rule ;
    rdfs:comment "Free-text wording of an access restriction, where the holding system records one beyond its restriction type."@en .
openricx:appliesToDescendants a owl:DatatypeProperty ; rdfs:label "applies to descendants"@en ;
    rdfs:domain rico:Rule ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether a rule attached to a record resource also governs every record resource below it in the hierarchy."@en .
openricx:securityLevel a owl:DatatypeProperty ; rdfs:label "security level"@en ;
    rdfs:domain rico:Rule ;
    rdfs:comment "Name of the security classification a rule assigns, for example 'Confidential'."@en .
openricx:securityLevelCode a owl:DatatypeProperty ; rdfs:label "security level code"@en ;
    rdfs:domain rico:Rule ;
    rdfs:comment "Code of the security classification a rule assigns, as the holding system's classification scheme gives it."@en .

# 2.18 Dates and occupations (added in 1.3.0)

openricx:hasDateOfExistence a owl:ObjectProperty ; rdfs:label "has date of existence"@en ;
    rdfs:subPropertyOf rico:isAssociatedWithDate ;
    rdfs:domain rico:Agent ; rdfs:range rico:Date ;
    rdfs:comment "Relates an agent to the date or date range of its existence. RiC-O 1.1 has birth, death and creation dates but no existence date for an agent in general, such as a corporate body or family; this specialises rico:isAssociatedWithDate."@en .
openricx:isCurrent a owl:DatatypeProperty ; rdfs:label "is current"@en ;
    rdfs:domain openricx:Occupation ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether an occupation is still held."@en .
